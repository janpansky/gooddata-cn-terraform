# Copy to providers.env (gitignored) and fill in secrets.
# providers.env is read by:
#   ./up.sh            — full stack start
#   ./helm/install-sie.sh  — creates sie-hf-token k8s secret
#   ./providers/register-providers.sh — registers LLM providers in GoodData CN

# --- GoodData CN org ---
TIGER_ENDPOINT="https://gooddata.local-inference.dev11.devgdc.com"
TIGER_API_TOKEN=""           # org API token (Settings → API Tokens in the UI)

# --- HuggingFace token ---
# Required for gated models (Gemma-4-26B-A4B-it requires accepting Google license).
# Read-only token is sufficient: https://huggingface.co/settings/tokens
# Llama-3.3-70B uses the public AWQ variant (no token needed for that one).
HF_TOKEN=""                  # hf_...

# --- Provider registration flags ---
# Set to "true" to register the provider in GoodData CN (./register-providers.sh).
# Only one provider is "active" at a time in gen-ai; toggle these to choose.
REGISTER_VLLM=true           # Qwen3.6-27B via vLLM (GPU 0)
REGISTER_SIE_LLAMA=true      # Llama-3.3-70B via SIE (GPU 1)
REGISTER_SIE_QWEN14B=true    # Qwen3-14B via SIE (GPU 2)
REGISTER_SIE_QWEN4B=true     # Qwen3-4B-Instruct-2507 via SIE (GPU 2, LRU)
REGISTER_SIE_QWEN35=true     # Qwen3.5-4B via SIE (GPU 2, LRU)
REGISTER_SIE_GEMMA=true      # Gemma-4-26B-A4B via SIE (GPU 3)

# --- vLLM — Qwen3.6-27B FP8 on GPU 0 ---
VLLM_BASE_URL="http://vllm.inference.svc.cluster.local:8000/v1"
VLLM_API_KEY="local"
VLLM_MODEL="Qwen/Qwen3.6-27B"

# --- SIE gateway (shared endpoint for all SIE models) ---
SIE_BASE_URL="http://sie-gateway.sie.svc.cluster.local:8080/v1"
SIE_API_KEY="local"          # unauthenticated in-cluster; any non-empty string

# --- SIE model IDs (must match sie_id in k8s/sie-models/*.yaml) ---
SIE_MODEL_LLAMA="meta-llama/Llama-3.3-70B-Instruct"
SIE_MODEL_QWEN14B="Qwen/Qwen3-14B"
SIE_MODEL_QWEN4B="Qwen/Qwen3-4B-Instruct-2507"
SIE_MODEL_QWEN35="Qwen/Qwen3.5-4B"
SIE_MODEL_GEMMA="google/gemma-4-26B-A4B-it"
